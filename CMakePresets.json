{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {"value": "x64", "strategy": "external"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {
      "name": "windows-gpu-release",
      "displayName": "Windows GPU (Release)",
      "inherits": "windows-base",
      "cacheVariables": {"GGLBOT_DEVICE": "gpu", "CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "windows-gpu-relwithdebinfo",
      "displayName": "Windows GPU (RelWithDebInfo)",
      "inherits": "windows-base",
      "cacheVariables": {"GGLBOT_DEVICE": "gpu", "CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "windows-cpu-release",
      "displayName": "Windows CPU (Release)",
      "inherits": "windows-base",
      "cacheVariables": {"GGLBOT_DEVICE": "cpu", "CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "windows-cpu-relwithdebinfo",
      "displayName": "Windows CPU (RelWithDebInfo)",
      "inherits": "windows-base",
      "cacheVariables": {"GGLBOT_DEVICE": "cpu", "CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "linux-cpu-release",
      "displayName": "Linux CPU (Release)",
      "inherits": "base",
      "cacheVariables": {"GGLBOT_DEVICE": "cpu", "CMAKE_BUILD_TYPE": "Release"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "linux-cpu-relwithdebinfo",
      "displayName": "Linux CPU (RelWithDebInfo)",
      "inherits": "base",
      "cacheVariables": {"GGLBOT_DEVICE": "cpu", "CMAKE_BUILD_TYPE": "RelWithDebInfo"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    }
  ],
  "buildPresets": [
    {"name": "windows-cpu-release", "configurePreset": "windows-cpu-release"},
    {"name": "windows-cpu-relwithdebinfo", "configurePreset": "windows-cpu-relwithdebinfo"},
    {"name": "windows-gpu-release", "configurePreset": "windows-gpu-release"},
    {"name": "windows-gpu-relwithdebinfo", "configurePreset": "windows-gpu-relwithdebinfo"},
    {"name": "linux-cpu-release", "configurePreset": "linux-cpu-release"},
    {"name": "linux-cpu-relwithdebinfo", "configurePreset": "linux-cpu-relwithdebinfo"}
  ]
}
